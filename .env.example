# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default — never commit real API keys.

# Required for the "Web search" box on the home page.
# Get a key from https://brave.com/search/api/ (sign up, add a payment
# method for identity verification, generate a subscription token).
# New accounts get a small free credit; usage beyond that is billed by
# Brave directly — see README "Web search setup" for current pricing.
BRAVE_SEARCH_API_KEY=
