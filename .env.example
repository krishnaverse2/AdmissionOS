# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default — never commit real API keys.

# =========================================================
# Brave Search API
# =========================================================
# Required for the "Web search" box on the home page.
# Get your key from the official Brave Search API dashboard.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here


# =========================================================
# OpenAI API
# =========================================================
# Required for the AdmissionOS AI Counselor.
# Never put a real API key in this .env.example file.
# Put the real secret key only inside .env.local.
OPENAI_API_KEY=your_openai_api_key_here